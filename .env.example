# Copy to .env and adjust the values. Used by docker-compose.yml / docker-compose.dev.yml
# for variable substitution. If you run the backend directly (./mvnw spring-boot:run,
# outside Docker), export these same variables in your shell first.

# General
COMPOSE_PROJECT_NAME=calendar

# Backend
BACKEND_PORT=8080

# JWT signing secret. Required — the backend refuses to start without it.
# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

# Password hashing pepper, appended to every password before it's hashed.
# Required — the backend refuses to start without it.
SECRET_PASSWORD_PEPPER=change-me-to-a-long-random-value

# Origins allowed to call the backend (CORS). Comma-separate for more than one.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Frontend
FRONTEND_PORT=4000
# Hosts allowed to be served by Angular SSR (anti-SSRF protection from @angular/ssr).
# Comma-separate if you need more than one, e.g.: mysite.com,www.mysite.com
NG_ALLOWED_HOSTS=localhost:4000

# Database
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=change_this_password